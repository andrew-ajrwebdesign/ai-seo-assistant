{
  "about": [
    "Shared behaviour cases for the two agency plugins' Secret_Store (AJR Core Framework\\Secret_Store, AI SEO Assistant Core\\Secret_Store).",
    "Both classes implement one scheme (libsodium secretbox, key from the auth salts, non-autoloaded array rows) but have different method names, so each repo reads this file through its own adapter test. The cases are the contract; the adapter maps them to that plugin's API.",
    "KEEP THIS FILE BYTE-IDENTICAL in both repos (tests/fixtures/secret-store-cases.json). A case added here is added to both, and both suites must pass it. Compare with: sha256sum tests/fixtures/secret-store-cases.json",
    "Origin: stack review round 2, 2026-10-06 (code-standards proposal 1): the two plugins drifted on the duplicate-salt check and on what a failed encryption leaves behind."
  ],
  "version": 1,
  "adapter": {
    "salts": "given.constants is the complete set of salt constants defined (a name not listed is NOT defined). Pass it to the class's pure salt test (salts_usable( array $defined ): bool, which salts_in_config() calls with the real constants). then.salts_in_config is the expected answer. Mirrors wp_salt(): a value shared by any two of AUTH/SECURE_AUTH/LOGGED_IN/NONCE/SECRET _KEY/_SALT, the sample phrase, or an empty value counts as unset.",
    "read": "Store given.plain through the class's normal write, then apply given.tamper to the stored row ('none'; 'cipher-bit' flips the lowest bit of decoded ciphertext byte given.byte; 'nonce-bit' the same on the nonce; 'truncate-cipher' keeps the first given.byte bytes of the ciphertext; 'cipher-not-base64' sets c to given.value; 'version' sets v to given.value; 'rotate-salts' changes what wp_salt() returns). then.get is what the plain-text read returns; then.unreadable (when present) is whether the class reports the row as stored-but-unreadable (the 're-enter the key' notice). then.row_keys (when present) is the stored row's keys in order. then.absent lists strings that must not appear anywhere in the options table.",
    "write": "Seed given.stored ('' = nothing stored) through the class's normal write while encryption works, then submit given.submit through the plugin's settings save path for that secret, with encryption available only when given.encryption is true. then.accepted is whether that save reports the secret as saved (false = the 'could not be encrypted, not saved' error). then.get is the value read back afterwards (encryption restored first); then.has whether any row exists; then.row_unchanged that the stored row is byte-for-byte what it was before the submit; then.absent as for read.",
    "legacy": "A pre-encryption install: given.plain sits where the plugin kept it in plain text before the scheme (the old setting/option). Read it once in request context given.context ('admin', 'cron', 'cli' or 'front') with encryption available per given.encryption. then.get is what that read returns (always the key: updating must never switch a feature off). then.sealed is whether the plain text was moved into an encrypted row by that read or its request; false means nothing was written at all. then.absent as above (checked after the read).",
    "constant": "given.stored is the stored secret ('' = none); given.constant is the wp-config.php constant's value, or null for not defined (the adapter uses a fresh constant name per case). then.resolved is the value the plugin uses."
  },
  "cases": [
    {
      "id": "salts-all-distinct",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": true }
    },
    {
      "id": "salts-duplicate-within-auth",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-same", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-same", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-duplicate-across-schemes",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-same", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "fx-same", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-duplicate-with-an-unused-salt",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-same", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-same" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-duplicate-with-secret-key",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-same", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4", "SECRET_KEY": "fx-same" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-duplicate-among-unused-only",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-same", "NONCE_KEY": "fx-same", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": true }
    },
    {
      "id": "salts-sample-phrase",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "put your unique phrase here", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-one-missing",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "fx-b1", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-one-empty",
      "kind": "salts",
      "given": { "constants": { "AUTH_KEY": "fx-a1", "SECURE_AUTH_KEY": "fx-a2", "LOGGED_IN_KEY": "fx-a3", "NONCE_KEY": "fx-a4", "AUTH_SALT": "", "SECURE_AUTH_SALT": "fx-b2", "LOGGED_IN_SALT": "fx-b3", "NONCE_SALT": "fx-b4" } },
      "then": { "salts_in_config": false }
    },
    {
      "id": "salts-none-defined",
      "kind": "salts",
      "given": { "constants": {} },
      "then": { "salts_in_config": false }
    },
    {
      "id": "read-round-trip",
      "kind": "read",
      "given": { "plain": "FIXTURE-ROUND-TRIP-KEY-0001", "tamper": "none" },
      "then": { "get": "FIXTURE-ROUND-TRIP-KEY-0001", "unreadable": false, "row_keys": [ "v", "n", "c" ], "absent": [ "FIXTURE-ROUND-TRIP" ] }
    },
    {
      "id": "read-tampered-cipher",
      "kind": "read",
      "given": { "plain": "FIXTURE-TAMPER-KEY-0002", "tamper": "cipher-bit", "byte": 5 },
      "then": { "get": "", "unreadable": true, "absent": [ "FIXTURE-TAMPER" ] }
    },
    {
      "id": "read-tampered-nonce",
      "kind": "read",
      "given": { "plain": "FIXTURE-TAMPER-KEY-0003", "tamper": "nonce-bit", "byte": 0 },
      "then": { "get": "", "unreadable": true, "absent": [ "FIXTURE-TAMPER" ] }
    },
    {
      "id": "read-truncated-cipher",
      "kind": "read",
      "given": { "plain": "FIXTURE-TAMPER-KEY-0004", "tamper": "truncate-cipher", "byte": 8 },
      "then": { "get": "", "unreadable": true, "absent": [ "FIXTURE-TAMPER" ] }
    },
    {
      "id": "read-cipher-not-base64",
      "kind": "read",
      "given": { "plain": "FIXTURE-TAMPER-KEY-0005", "tamper": "cipher-not-base64", "value": "not base64 !!" },
      "then": { "get": "", "unreadable": true, "absent": [ "FIXTURE-TAMPER" ] }
    },
    {
      "id": "read-rotated-salts",
      "kind": "read",
      "given": { "plain": "FIXTURE-ROTATED-KEY-0006", "tamper": "rotate-salts" },
      "then": { "get": "", "unreadable": true, "absent": [ "FIXTURE-ROTATED" ] }
    },
    {
      "id": "read-unknown-version",
      "kind": "read",
      "given": { "plain": "FIXTURE-VERSION-KEY-0007", "tamper": "version", "value": 2 },
      "then": { "get": "", "absent": [ "FIXTURE-VERSION" ] }
    },
    {
      "id": "write-empty-submit-keeps",
      "kind": "write",
      "given": { "stored": "FIXTURE-STORED-KEY-0101", "submit": "", "encryption": true },
      "then": { "accepted": true, "get": "FIXTURE-STORED-KEY-0101", "has": true, "row_unchanged": true, "absent": [ "FIXTURE-STORED" ] }
    },
    {
      "id": "write-whitespace-submit-keeps",
      "kind": "write",
      "given": { "stored": "FIXTURE-STORED-KEY-0102", "submit": "   ", "encryption": true },
      "then": { "accepted": true, "get": "FIXTURE-STORED-KEY-0102", "has": true, "row_unchanged": true, "absent": [ "FIXTURE-STORED" ] }
    },
    {
      "id": "write-new-value-replaces",
      "kind": "write",
      "given": { "stored": "FIXTURE-STORED-KEY-0103", "submit": "FIXTURE-NEW-KEY-0103", "encryption": true },
      "then": { "accepted": true, "get": "FIXTURE-NEW-KEY-0103", "has": true, "row_unchanged": false, "absent": [ "FIXTURE-STORED", "FIXTURE-NEW" ] }
    },
    {
      "id": "write-into-nothing",
      "kind": "write",
      "given": { "stored": "", "submit": "FIXTURE-NEW-KEY-0104", "encryption": true },
      "then": { "accepted": true, "get": "FIXTURE-NEW-KEY-0104", "has": true, "absent": [ "FIXTURE-NEW" ] }
    },
    {
      "id": "write-empty-into-nothing",
      "kind": "write",
      "given": { "stored": "", "submit": "", "encryption": true },
      "then": { "accepted": true, "get": "", "has": false }
    },
    {
      "id": "write-failed-encryption-new",
      "kind": "write",
      "given": { "stored": "", "submit": "FIXTURE-PLAIN-KEY-0105", "encryption": false },
      "then": { "accepted": false, "get": "", "has": false, "absent": [ "FIXTURE-PLAIN" ] }
    },
    {
      "id": "write-failed-encryption-replace",
      "kind": "write",
      "given": { "stored": "FIXTURE-STORED-KEY-0106", "submit": "FIXTURE-PLAIN-KEY-0106", "encryption": false },
      "then": { "accepted": false, "get": "FIXTURE-STORED-KEY-0106", "has": true, "row_unchanged": true, "absent": [ "FIXTURE-PLAIN", "FIXTURE-STORED" ] }
    },
    {
      "id": "legacy-plain-sealed-in-admin",
      "kind": "legacy",
      "given": { "plain": "FIXTURE-LEGACY-KEY-0201", "context": "admin", "encryption": true },
      "then": { "get": "FIXTURE-LEGACY-KEY-0201", "sealed": true, "absent": [ "FIXTURE-LEGACY" ] }
    },
    {
      "id": "legacy-plain-sealed-in-cron",
      "kind": "legacy",
      "given": { "plain": "FIXTURE-LEGACY-KEY-0202", "context": "cron", "encryption": true },
      "then": { "get": "FIXTURE-LEGACY-KEY-0202", "sealed": true, "absent": [ "FIXTURE-LEGACY" ] }
    },
    {
      "id": "legacy-plain-sealed-in-cli",
      "kind": "legacy",
      "given": { "plain": "FIXTURE-LEGACY-KEY-0203", "context": "cli", "encryption": true },
      "then": { "get": "FIXTURE-LEGACY-KEY-0203", "sealed": true, "absent": [ "FIXTURE-LEGACY" ] }
    },
    {
      "id": "legacy-plain-never-written-on-front-end",
      "kind": "legacy",
      "given": { "plain": "FIXTURE-LEGACY-KEY-0204", "context": "front", "encryption": true },
      "then": { "get": "FIXTURE-LEGACY-KEY-0204", "sealed": false }
    },
    {
      "id": "legacy-plain-kept-when-encryption-fails",
      "kind": "legacy",
      "given": { "plain": "FIXTURE-LEGACY-KEY-0205", "context": "admin", "encryption": false },
      "then": { "get": "FIXTURE-LEGACY-KEY-0205", "sealed": false }
    },
    {
      "id": "constant-wins",
      "kind": "constant",
      "given": { "stored": "FIXTURE-STORED-KEY-0301", "constant": "FIXTURE-CONSTANT-KEY-0301" },
      "then": { "resolved": "FIXTURE-CONSTANT-KEY-0301" }
    },
    {
      "id": "constant-wins-with-nothing-stored",
      "kind": "constant",
      "given": { "stored": "", "constant": "FIXTURE-CONSTANT-KEY-0302" },
      "then": { "resolved": "FIXTURE-CONSTANT-KEY-0302" }
    },
    {
      "id": "constant-undefined-uses-stored",
      "kind": "constant",
      "given": { "stored": "FIXTURE-STORED-KEY-0303", "constant": null },
      "then": { "resolved": "FIXTURE-STORED-KEY-0303" }
    },
    {
      "id": "constant-empty-uses-stored",
      "kind": "constant",
      "given": { "stored": "FIXTURE-STORED-KEY-0304", "constant": "" },
      "then": { "resolved": "FIXTURE-STORED-KEY-0304" }
    },
    {
      "id": "constant-whitespace-uses-stored",
      "kind": "constant",
      "given": { "stored": "FIXTURE-STORED-KEY-0305", "constant": "   " },
      "then": { "resolved": "FIXTURE-STORED-KEY-0305" }
    }
  ]
}
